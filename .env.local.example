# Supabase (shared with the-potential)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (for AI generation)
OPENROUTER_API_KEY=sk-or-v1-xxx
SITE_URL=https://potenpaper.com

# 크레딧 과금 (멤버십)
# true 로 바꾸는 순간 consume_credits RPC 호출 시작 (실제 차감)
# 베타 기간엔 false 또는 미설정 → no-op
NEXT_PUBLIC_BILLING_ENABLED=false
# 잔액 부족 모달 + /pricing CTA 가 가리키는 크레딧 구매 페이지
NEXT_PUBLIC_PURCHASE_URL=https://thepotential.kr/credits
